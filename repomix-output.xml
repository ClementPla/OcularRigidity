import torch
import torch.nn.functional as F
import numpy as np
from ocularrigidity.rigidity.features import extract_thickness_gpu
from ocularrigidity.segmentation.postprocess.smoothing import extract_boundaries_gpu


def estimate_lateral_shift_xcorr(
    curve: torch.Tensor, ref_curve: torch.Tensor, max_shift: int = None
) -> torch.Tensor:
    """
    curve: T x W, ref_curve: W
    Returns dx: T, the integer lateral shift (in columns) that best aligns
    curve[t] to ref_curve via 1D cross-correlation (sliding ref_curve is
    treated as the target; positive dx means curve[t] is shifted right
    relative to ref_curve).
    """
    T, W = curve.shape
    if max_shift is None:
        max_shift = W // 4

    c = curve - curve.mean(dim=1, keepdim=True)
    r = ref_curve - ref_curve.mean()

    shifts = torch.arange(-max_shift, max_shift + 1, device=curve.device)
    scores = torch.zeros(T, len(shifts), device=curve.device)

    for i, s in enumerate(shifts):
        s = int(s.item())
        if s >= 0:
            c_seg = c[:, : W - s] if s > 0 else c
            r_seg = r[s:] if s > 0 else r
        else:
            c_seg = c[:, -s:]
            r_seg = r[: W + s]
        scores[:, i] = (c_seg * r_seg).sum(dim=1)

    best_idx = scores.argmax(dim=1)
    dx = shifts[best_idx].float()
    return dx


@torch.no_grad()
def register_masks_by_displacement(
    raw_masks: torch.Tensor,
    raw_frames: torch.Tensor,
    include_dx_estimation: bool = True,
    batch_size: int = 256,
    device: str = "cuda",
):
    if isinstance(raw_masks, np.ndarray):
        raw_masks = torch.from_numpy(raw_masks).to(device)
    if isinstance(raw_frames, np.ndarray):
        raw_frames = torch.from_numpy(raw_frames).to(device)
    T, H, W = raw_masks.shape
    device = raw_masks.device
    mask_dtype = raw_masks.dtype
    frame_dtype = raw_frames.dtype

    ys = torch.arange(H, device=device, dtype=torch.float32)
    xs = torch.arange(W, device=device, dtype=torch.float32)

    # --- Pass 1: Global Boundary Extraction & dx Estimation ---
    # Chunking just the boundary extraction to be safe on memory
    bms_list = []
    csi_list = []
    for start in range(0, T, batch_size):
        end = min(start + batch_size, T)
        masks_chunk = raw_masks[start:end].to(torch.float32)
        bm, csi = extract_boundaries_gpu(masks_chunk, to_numpy=False)
        bms_list.append(bm)
        csi_list.append(csi)

    all_bms = torch.cat(bms_list, dim=0)  # T x W
    all_csi = torch.cat(csi_list, dim=0)  # T x W
    ref_bm = all_bms[0]  # W
    ref_csi = all_csi[0]  # W
    thicknesses = extract_thickness_gpu(raw_masks.cpu().numpy())  # T x W
    thicknesses = torch.from_numpy(thicknesses).cuda()
    if include_dx_estimation:
        global_dx = estimate_lateral_shift_xcorr(all_bms, all_bms[0], 5)  # T

    # --- Pass 2: Chunked Heavy 2D Image Registration ---
    registered_masks_chunks = [raw_masks[0:1].to(mask_dtype).cpu()]
    registered_frames_chunks = [raw_frames[0:1].to(frame_dtype).cpu()]

    for start in range(1, T, batch_size):
        end = min(start + batch_size, T)
        t = end - start

        masks_chunk = raw_masks[start:end].to(torch.float32)
        frames_chunk = raw_frames[start:end].to(torch.float32)

        grid_y = ys.view(1, H, 1).expand(t, H, W)
        grid_x = xs.view(1, 1, W).expand(t, H, W)

        bm_chunk = all_bms[start:end]

        if include_dx_estimation:
            # Grab the pre-computed, correctly smoothed shifts for this chunk
            dx_chunk = global_dx[start:end]

            sample_x = grid_x + dx_chunk.view(t, 1, 1)
            norm_x = sample_x / (W - 1) * 2 - 1
            norm_y = grid_y / (H - 1) * 2 - 1
            grid_x_only = torch.stack([norm_x, norm_y], dim=-1)

            masks_x_aligned = F.grid_sample(
                masks_chunk.unsqueeze(1),
                grid_x_only,
                mode="bilinear",
                padding_mode="zeros",
                align_corners=True,
            )
            frames_x_aligned = F.grid_sample(
                frames_chunk.unsqueeze(1),
                grid_x_only,
                mode="bilinear",
                padding_mode="zeros",
                align_corners=True,
            )

            bm_aligned, _ = extract_boundaries_gpu(
                masks_x_aligned.squeeze(1), to_numpy=False
            )  # t x W
        else:
            masks_x_aligned = masks_chunk.unsqueeze(1)
            frames_x_aligned = frames_chunk.unsqueeze(1)
            bm_aligned = bm_chunk

        displacement = bm_aligned - ref_bm.unsqueeze(0)  # t x W

        sample_y = grid_y + displacement.view(t, 1, W)
        norm_y2 = sample_y / (H - 1) * 2 - 1
        norm_x2 = grid_x / (W - 1) * 2 - 1
        grid_y_only = torch.stack([norm_x2, norm_y2], dim=-1)

        reg_masks_chunk = F.grid_sample(
            masks_x_aligned,
            grid_y_only,
            mode="bilinear",
            padding_mode="zeros",
            align_corners=True,
        ).squeeze(1)

        reg_frames_chunk = F.grid_sample(
            frames_x_aligned,
            grid_y_only,
            mode="bilinear",
            padding_mode="zeros",
            align_corners=True,
        ).squeeze(1)

        registered_masks_chunks.append(reg_masks_chunk.to(mask_dtype).cpu())
        registered_frames_chunks.append(reg_frames_chunk.to(frame_dtype).cpu())

        # Cleanup chunk memory
        del masks_chunk, frames_chunk, masks_x_aligned, frames_x_aligned
        del bm_chunk, bm_aligned, displacement
        if include_dx_estimation:
            del dx_chunk
        torch.cuda.empty_cache()

    return torch.cat(registered_masks_chunks, dim=0), torch.cat(
        registered_frames_chunks, dim=0
    )
